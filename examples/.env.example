# =============================================================================
# Hermes Agent — environment variables
# Copy file ini ke ~/.hermes/.env, isi nilainya, JANGAN commit ke git.
# =============================================================================

# -----------------------------------------------------------------------------
# PRIMARY MODEL: DeepSeek V4 Flash via custom OpenAI-compatible endpoint
# -----------------------------------------------------------------------------
# Daftar di https://platform.deepseek.com -> bikin API key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-deepseek-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
LLM_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# SECONDARY MODEL: OpenCode Go subscription bundle
# -----------------------------------------------------------------------------
# Subscribe di https://opencode.ai/go
OPENCODE_GO_API_KEY=oc-go-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# AUXILIARY (vision, web extract, compression) — direkomendasikan via OpenRouter
# -----------------------------------------------------------------------------
# Daftar di https://openrouter.ai (nge-proxy banyak provider, termasuk Gemini Flash murah)
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# TELEGRAM GATEWAY (untuk doc 08)
# -----------------------------------------------------------------------------
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# User ID lo (cari via @userinfobot di Telegram). Comma-separated kalau >1 user.
TELEGRAM_ALLOWED_USERS=123456789
# Home channel untuk delivery cronjob (opsional, bisa di-set dengan /sethome di chat)
# TELEGRAM_HOME_CHANNEL=-1001234567890
# TELEGRAM_HOME_CHANNEL_NAME="Notes"

# -----------------------------------------------------------------------------
# WEB SEARCH / SCRAPING (untuk skill scraping)
# -----------------------------------------------------------------------------
# Pilih SALAH SATU backend (auto-detected dari env yang tersedia):
# 1. Firecrawl (default, paling lengkap untuk anti-bot bypass) — https://firecrawl.dev
FIRECRAWL_API_KEY=fc-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# 2. Tavily (alternatif lebih murah) — https://tavily.com
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXX
# 3. Parallel — https://parallel.ai
# PARALLEL_API_KEY=para-XXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# VOICE / AUDIO (kalau lo mau voice messages, summary video)
# -----------------------------------------------------------------------------
# Speech-to-text: 'local' (faster-whisper, gratis), 'groq' (cepat), atau 'openai'
# Kalau pakai Groq:
# GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXX
# Kalau pakai OpenAI Whisper:
# VOICE_TOOLS_OPENAI_KEY=sk-XXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# OPTIONAL — image generation, premium TTS
# -----------------------------------------------------------------------------
# FAL_KEY=...                # Image generation via FAL — https://fal.ai
# ELEVENLABS_API_KEY=...     # TTS premium — https://elevenlabs.io
