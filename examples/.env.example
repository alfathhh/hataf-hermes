# =============================================================================
# Hermes Agent — environment variables (BALANCED strategy, OpenCode Go only)
# Copy file ini ke ~/.hermes/.env, isi nilainya, JANGAN commit ke git.
# =============================================================================

# -----------------------------------------------------------------------------
# PRIMARY PROVIDER: OpenCode Go subscription ($10/bulan)
# -----------------------------------------------------------------------------
# Subscribe di https://opencode.ai/go
OPENCODE_GO_API_KEY=oc-go-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# AUXILIARY (vision) — perlu OpenRouter karena model OpenCode Go gak ada vision
# -----------------------------------------------------------------------------
# Daftar di https://openrouter.ai
OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# TELEGRAM GATEWAY
# -----------------------------------------------------------------------------
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# User ID lo (cari via @userinfobot di Telegram). Comma-separated kalau >1 user.
TELEGRAM_ALLOWED_USERS=123456789
# Home channel untuk delivery cronjob (opsional, bisa di-set dengan /sethome di chat)
# TELEGRAM_HOME_CHANNEL=-1001234567890

# -----------------------------------------------------------------------------
# WEB SEARCH / SCRAPING
# -----------------------------------------------------------------------------
# Pilih SALAH SATU backend:
FIRECRAWL_API_KEY=fc-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# VOICE / AUDIO (untuk STT — voice message + video summary)
# -----------------------------------------------------------------------------
# Default 'local' (faster-whisper, gratis). Atau:
# GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXX
# VOICE_TOOLS_OPENAI_KEY=sk-XXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# DEEPSEEK THINKING MODE (opsional, buat reasoning_effort high/xhigh)
# -----------------------------------------------------------------------------
# Kalau model di OpenCode Go support thinking parameter, ini otomatis aktif
# lewat config.yaml agent.reasoning_effort setting.
# Gak perlu env var tambahan — cukup set reasoning_effort di config.yaml.
#
# Untuk switch on-the-fly di chat:
#   /reasoning high     → aktifin deep thinking
#   /reasoning medium   → default
#   /reasoning none     → matiin thinking (cepat, murah)
